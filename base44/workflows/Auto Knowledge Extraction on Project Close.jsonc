{
  "name": "Auto Knowledge Extraction on Project Close",
  "description": "Automatically extracts lessons learned, pricing patterns, workflows, recurring problems and recommended suppliers to Knowledge Base when a project is marked as Delivered or Archived.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"Delivered\" or .trigger.data.status == \"Archived\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Project"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_knowledge_extraction_on_project_close",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "extractProjectKnowledge",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "extractProjectKnowledge"
  }
}