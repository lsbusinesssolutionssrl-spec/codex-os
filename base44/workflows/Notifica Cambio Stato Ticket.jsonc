{
  "name": "Notifica Cambio Stato Ticket",
  "description": "Invia email al cliente quando lo stato del ticket cambia",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "SupportTicket"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notifica_cambio_stato_ticket",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyTicketStatusChanged",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyTicketStatusChanged"
  }
}